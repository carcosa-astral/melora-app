// The library list: album (or DJ) headings, disc headings and tracks. Rust (rows.rs) knows where
// every row sits and hands over only the rows in view, each with its place, so scrolling to any
// row is exact however tall the headings are.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// kind: 0 album heading, 1 disc heading, 2 track, 3 DJ heading, 4 mix, 5 station.
export struct Row {
    kind: int,
    // Position in the whole list (not just the rows in view).
    index: int,
    title: string,
    subtitle: string,
    number: string,
    length: string,
    y: length,
    height: length,
    playing: bool,
    // Album rows: the cover, once loaded.
    art: image,
    has-art: bool,
}

// Album covers sit left of their album, as in 2.x; titles, disc headings and tracks line up
// to their right.
global Layout {
    out property <length> cover: 168px;          // rows.rs COVER_SIZE
    out property <length> margin: 20px;
    out property <length> indent: 20px + 168px + 20px;
    // Mixes: the DJ's round picture, and their mixes lined up with their name (as in 2.x).
    out property <length> dj-picture: 44px;      // rows.rs DJ_PICTURE_SIZE
    out property <length> mix-indent: 20px + 44px + 12px;
}

component RowView inherits Rectangle {
    in property <Row> item;
    in property <bool> selected;
    in property <int> index;
    in property <int> count;
    callback clicked();
    callback double-clicked();
    // Right-click, at this point in the window.
    callback menu(length, length);

    height: item.height;
    accessible-role: list-item;
    accessible-label: item.kind == 0 ? "Album: " + item.title + ", " + item.subtitle
        : item.kind == 3 ? "DJ: " + item.title + ", " + item.subtitle
        : item.kind == 5 ? item.title + ", " + item.subtitle + (item.playing ? ", playing" : "")
        : item.kind == 1 ? item.title
        : item.title + (item.subtitle == "" ? "" : ", " + item.subtitle) + ", " + item.length + (item.playing ? ", playing" : "");
    accessible-item-selectable: item.kind == 2 || item.kind == 4 || item.kind == 5;
    accessible-item-selected: selected;
    accessible-item-index: index;
    accessible-item-count: count;

    // The selection only covers the track itself, never the cover beside it.
    if selected: Rectangle {
        x: (item.kind == 4 ? Layout.mix-indent : item.kind == 5 ? Layout.margin : Layout.indent) - 8px;
        width: parent.width - self.x - 12px;
        border-radius: 4px;
        background: Theme.panel;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }

    if item.kind == 0: Rectangle {
        // The cover reaches below this row, beside the album's tracks; the list keeps room for it.
        Rectangle {
            x: Layout.margin;
            y: Layout.margin;
            width: Layout.cover;
            height: Layout.cover;
            border-radius: 6px;
            clip: true;
            background: Theme.panel;
            if !item.has-art: Text {
                text: "\u{E8D6}";
                font-family: "Segoe Fluent Icons";
                font-size: 36px;
                color: Theme.divider;
            }
            if item.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: item.art;
                image-fit: cover;
            }
        }
        VerticalLayout {
            x: Layout.indent;
            width: parent.width - self.x - 16px;
            padding-top: Layout.margin + 2px;
            spacing: 2px;
            alignment: start;
            Text {
                text: item.title;
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: item.subtitle;
                color: Theme.dim;
                overflow: elide;
            }
        }
    }

    if item.kind == 1: Text {
        x: Layout.indent;
        y: 8px;
        height: parent.height - 8px;
        text: item.title;
        font-size: 12px;
        font-weight: 600;
        color: Theme.dim;
        vertical-alignment: center;
    }

    if item.kind == 3: Rectangle {
        Rectangle {
            x: Layout.margin;
            y: Layout.margin;
            width: Layout.dj-picture;
            height: Layout.dj-picture;
            border-radius: self.width / 2;
            clip: true;
            background: Theme.panel;
            if !item.has-art: Text {
                text: "\u{E77B}";
                font-family: "Segoe Fluent Icons";
                font-size: 16px;
                color: Theme.dim;
            }
            if item.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: item.art;
                image-fit: cover;
            }
        }
        HorizontalLayout {
            x: Layout.mix-indent;
            y: Layout.margin;
            height: Layout.dj-picture;
            width: parent.width - self.x - 16px;
            spacing: 12px;
            Text {
                text: item.title;
                font-size: 16px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: item.subtitle;
                font-size: 12px;
                color: Theme.dim;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }

    if item.kind == 5: Rectangle {
        Rectangle {
            x: Layout.margin;
            y: (parent.height - self.height) / 2;
            width: 36px;                         // rows.rs LOGO_SIZE
            height: 36px;
            border-radius: self.width / 2;
            background: Theme.panel;
            if !item.has-art: Text {
                text: "\u{EC05}";
                font-family: "Segoe Fluent Icons";
                font-size: 15px;
                color: item.playing ? Theme.accent : Theme.dim;
            }
            if item.has-art: Image {
                width: parent.width;
                height: parent.height;
                source: item.art;
                image-fit: cover;
            }
        }
        VerticalLayout {
            x: Layout.margin + 36px + 14px;
            width: parent.width - self.x - 20px;
            alignment: center;
            spacing: 2px;
            Text {
                text: item.title;
                font-size: 13.5px;
                color: item.playing ? Theme.accent : Theme.text;
                overflow: elide;
            }
            Text {
                text: item.subtitle;
                font-size: 12px;
                color: Theme.dim;
                overflow: elide;
            }
        }
    }

    if item.kind == 4: HorizontalLayout {
        x: Layout.mix-indent;
        width: parent.width - self.x - 20px;
        spacing: 16px;
        Text {
            text: item.title;
            color: item.playing ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.subtitle;
            color: Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            // Fixed share of the row, so every artist starts at the same x.
            min-width: parent.width * 0.25;
            max-width: parent.width * 0.25;
        }
        Text {
            text: item.length;
            color: Theme.dim;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 56px;
        }
    }

    if item.kind == 2: HorizontalLayout {
        x: Layout.indent;
        width: parent.width - self.x - 20px;
        spacing: 12px;
        Text {
            text: item.playing ? "▶" : item.number;
            width: 22px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: item.playing ? Theme.accent : Theme.dim;
        }
        Text {
            text: item.title;
            color: item.playing ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.subtitle;
            color: Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            // Fixed share of the row, so every artist starts at the same x.
            min-width: parent.width * 0.25;
            max-width: parent.width * 0.25;
        }
        Text {
            text: item.length;
            color: Theme.dim;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 48px;
        }
    }
}

// Arrow keys, Page Up/Down and Home/End move the selection (`move-selection` with a step count;
// the Rust side skips headings and scrolls); Enter and double-click play.
export component TrackList inherits FocusScope {
    // Only the rows in view; `count` and `total-height` describe the whole list.
    in property <[Row]> rows;
    in property <int> count;
    in property <length> total-height;
    // The list position of the first row in `rows`, so screen readers can be pointed at the
    // selected row among the ones that exist.
    in property <int> first-row;
    in-out property <int> selected: -1;
    // How far down the list is scrolled (0 at the top), read and set by Rust.
    in-out property <length> scroll-y;
    out property <length> view-height: sv.visible-height;
    in property <string> label;
    callback move-selection(int);
    callback activate(int);
    // Radio: F2 edits, Delete removes, right-click opens the station menu (at a window point).
    callback edit-row(int);
    callback delete-row(int);
    // Type to jump: letters typed in the list. True when used (Space only while typing a name).
    callback typed(string) -> bool;
    callback row-menu(int, length, length);
    // The scroll position or the height changed: Rust hands over the rows now in view.
    callback view-changed();

    // Rust moves scroll-y; the wheel and the scrollbar move the ScrollView. Each follows the other.
    property <length> content-y: sv.content-y;
    changed content-y => { scroll-y = -content-y; view-changed(); }
    changed scroll-y => { sv.content-y = -scroll-y; view-changed(); }
    changed view-height => { view-changed(); }

    key-pressed(e) => {
        if (e.modifiers.control || e.modifiers.alt) { return reject; }
        if (e.text == Key.DownArrow) { move-selection(1); return accept; }
        if (e.text == Key.UpArrow) { move-selection(-1); return accept; }
        if (e.text == Key.PageDown) { move-selection(12); return accept; }
        if (e.text == Key.PageUp) { move-selection(-12); return accept; }
        if (e.text == Key.Home) { move-selection(-1000000); return accept; }
        if (e.text == Key.End) { move-selection(1000000); return accept; }
        if (e.text == Key.Return && selected >= 0) { activate(selected); return accept; }
        if (e.text == Key.F2 && selected >= 0) { edit-row(selected); return accept; }
        if (typed(e.text)) { return accept; }
        if (e.text == Key.Delete && selected >= 0) { delete-row(selected); return accept; }
        reject
    }

    sv := ScrollView {
        content-height: root.total-height;
        content-width: self.visible-width;
        accessible-role: list;
        accessible-label: root.label;
        accessible-item-count: root.count;
        // Screen readers follow the selected row as the arrow keys move it.
        accessible-delegate-focus: root.selected - root.first-row;

        for row in root.rows: RowView {
            x: 0;
            y: row.y;
            width: sv.visible-width;
            item: row;
            index: row.index;
            count: root.count;
            selected: row.index == root.selected;
            clicked => {
                root.focus();
                if (row.kind == 2 || row.kind == 4 || row.kind == 5) { root.selected = row.index; }
            }
            double-clicked => {
                if (row.kind == 2 || row.kind == 4 || row.kind == 5) { root.activate(row.index); }
            }
            menu(x, y) => {
                root.focus();
                if (row.kind == 5) {
                    root.selected = row.index;
                    root.row-menu(row.index, x, y);
                }
            }
        }
    }
}
