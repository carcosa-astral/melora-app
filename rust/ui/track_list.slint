// The library list: album (or DJ) headings, disc headings and tracks. Rust (rows.rs) knows where
// every row sits and hands over only the rows in view, each with its place, so scrolling to any
// row is exact however tall the headings are.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// kind: 0 album heading, 1 disc heading, 2 track.
export struct Row {
    kind: int,
    // Position in the whole list (not just the rows in view).
    index: int,
    title: string,
    subtitle: string,
    number: string,
    length: string,
    y: length,
    height: length,
    playing: bool,
}

component RowView inherits Rectangle {
    in property <Row> item;
    in property <bool> selected;
    in property <int> index;
    in property <int> count;
    callback clicked();
    callback double-clicked();

    height: item.height;
    background: selected ? Theme.panel : transparent;
    accessible-role: list-item;
    accessible-label: item.kind == 0 ? "Album: " + item.title + ", " + item.subtitle
        : item.kind == 1 ? item.title
        : item.title + (item.subtitle == "" ? "" : ", " + item.subtitle) + ", " + item.length + (item.playing ? ", playing" : "");
    accessible-item-selectable: item.kind == 2;
    accessible-item-selected: selected;
    accessible-item-index: index;
    accessible-item-count: count;

    TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    if item.kind == 0: HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 14px;
        padding-bottom: 6px;
        spacing: 12px;
        // Covers come later in phase 2; a plain square holds their place.
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 4px;
            background: Theme.panel;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: item.title;
                font-size: 15px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: item.subtitle;
                color: Theme.dim;
                overflow: elide;
            }
        }
    }

    if item.kind == 1: HorizontalLayout {
        padding-left: 80px;
        padding-top: 8px;
        Text {
            text: item.title;
            font-size: 12px;
            font-weight: 600;
            color: Theme.dim;
            vertical-alignment: center;
        }
    }

    if item.kind == 2: HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 12px;
        Text {
            text: item.playing ? "▶" : item.number;
            width: 52px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: item.playing ? Theme.accent : Theme.dim;
        }
        Text {
            text: item.title;
            color: item.playing ? Theme.accent : Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: item.subtitle;
            color: Theme.dim;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 0.6;
        }
        Text {
            text: item.length;
            color: Theme.dim;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 48px;
        }
    }
}

// Arrow keys, Page Up/Down and Home/End move the selection (`move-selection` with a step count;
// the Rust side skips headings and scrolls); Enter and double-click play.
export component TrackList inherits FocusScope {
    // Only the rows in view; `count` and `total-height` describe the whole list.
    in property <[Row]> rows;
    in property <int> count;
    in property <length> total-height;
    in-out property <int> selected: -1;
    // How far down the list is scrolled (0 at the top), read and set by Rust.
    in-out property <length> scroll-y;
    out property <length> view-height: sv.visible-height;
    in property <string> label;
    callback move-selection(int);
    callback activate(int);
    // The scroll position or the height changed: Rust hands over the rows now in view.
    callback view-changed();

    // Rust moves scroll-y; the wheel and the scrollbar move the ScrollView. Each follows the other.
    property <length> content-y: sv.content-y;
    changed content-y => { scroll-y = -content-y; view-changed(); }
    changed scroll-y => { sv.content-y = -scroll-y; view-changed(); }
    changed view-height => { view-changed(); }

    key-pressed(e) => {
        if (e.modifiers.control || e.modifiers.alt) { return reject; }
        if (e.text == Key.DownArrow) { move-selection(1); return accept; }
        if (e.text == Key.UpArrow) { move-selection(-1); return accept; }
        if (e.text == Key.PageDown) { move-selection(12); return accept; }
        if (e.text == Key.PageUp) { move-selection(-12); return accept; }
        if (e.text == Key.Home) { move-selection(-1000000); return accept; }
        if (e.text == Key.End) { move-selection(1000000); return accept; }
        if (e.text == Key.Return && selected >= 0) { activate(selected); return accept; }
        reject
    }

    sv := ScrollView {
        content-height: root.total-height;
        content-width: self.visible-width;
        accessible-role: list;
        accessible-label: root.label;
        accessible-item-count: root.count;

        for row in root.rows: RowView {
            x: 0;
            y: row.y;
            width: sv.visible-width;
            item: row;
            index: row.index;
            count: root.count;
            selected: row.index == root.selected;
            clicked => {
                root.focus();
                if (row.kind == 2) { root.selected = row.index; }
            }
            double-clicked => {
                if (row.kind == 2) { root.activate(row.index); }
            }
        }
    }
}
