// Melora 3.0's window, laid out as 2.x's: the transport bar, the library tabs, the list, and a
// status bar with what's playing. Nord colours, IBM Plex Sans and Mono.
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import { Theme } from "theme.slint";
import { IconButton, TabButton, TextButton, ThinSlider } from "controls.slint";
import { Row, TrackList } from "track_list.slint";
import { Button } from "std-widgets.slint";
import { Account, ConfirmPanel, MenuItem, SettingsPanel, StationEditor } from "dialogs.slint";

export { Row, Account }

export component AppWindow inherits Window {
    title: window-title;
    icon: @image-url("icon-64.png");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 320px;
    background: Theme.background;
    default-font-family: "IBM Plex Sans";
    default-font-size: 13px;

    // "Artist – Title · Melora", or "Melora".
    in property <string> window-title: "Melora";
    // The status bar: what's playing ("Artist – Title"), and its format ("FLAC · 44.1 kHz · …").
    in property <string> now-playing;
    in property <string> format-text;
    in property <bool> playing;
    in property <bool> loaded;
    // A radio station is on: Play becomes Stop, and there's nothing to seek.
    in property <bool> live;
    in property <float> length;
    in-out property <float> position;
    in property <string> time-text;
    // The rows in view, and the whole list's size (see TrackList).
    in property <[Row]> rows;
    in property <int> row-count;
    in property <length> list-height;
    in-out property <int> selected: -1;
    in-out property <length> list-scroll <=> list.scroll-y;
    out property <length> list-view-height: list.view-height;
    // "1,234 tracks · 3d 4h", or what a scan is doing.
    in property <string> summary;
    // 0 Music, 1 Mixes, 2 Radio.
    in property <int> tab;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    // 0 to 100.
    in-out property <float> volume: 100;
    // While the seek bar is being dragged, playback mustn't move it back.
    out property <bool> seeking: seek-bar.dragging;

    // Radio: the station editor and the delete confirmation (set by Rust).
    in-out property <bool> editor-open;
    in property <string> editor-heading;
    in-out property <string> editor-url;
    in-out property <string> editor-name;
    in property <string> editor-status;
    in property <bool> editor-error;
    in property <bool> editor-busy;
    in-out property <bool> confirm-open;
    in property <string> confirm-message;
    // Settings (filled in by Rust when it opens).
    in-out property <bool> settings-open;
    in property <[string]> music-folders;
    in property <[string]> mixes-folders;
    in-out property <bool> minimize-to-tray;
    in-out property <bool> online-art;
    in property <string> version;
    in property <string> settings-note;
    in-out property <bool> scrobble-mixes;
    in property <string> pending;
    in property <Account> lastfm;
    in property <Account> listenbrainz;
    in-out property <string> lastfm-key;
    in-out property <string> lastfm-secret;
    in-out property <string> listenbrainz-token;
    // The heart: shown while a track (not radio) plays and a scrobbling service is connected.
    in property <bool> can-love;
    in property <bool> loved;
    in-out property <bool> discord-enabled;
    in-out property <string> discord-app-id;
    in property <string> discord-status;
    in-out property <bool> discord-mixes;
    in-out property <bool> discord-radio;
    property <int> menu-row: -1;
    property <length> menu-x;
    property <length> menu-y;

    // Add a folder to Music (0) or Mixes (1); remove one.
    callback add-folder(int);
    callback remove-folder(int, string);
    callback open-settings();
    callback open-log();
    in-out property <bool> update-enabled;
    in property <string> update-status;
    in property <string> update-available;
    callback update-enabled-changed(bool);
    callback check-updates();
    callback open-update();
    // An update check finished in the background.
    callback update-checked();
    // Settings has just opened (Rust fills in the update line).
    callback settings-shown();
    callback toggle-love();
    callback scrobble-mixes-changed(bool);
    callback lastfm-connect();
    callback lastfm-disconnect();
    callback listenbrainz-connect();
    callback listenbrainz-disconnect();
    // The scrobbler has news (sent plays, a love checked, a connect step).
    callback scrobbler-report();
    callback discord-enabled-changed(bool);
    callback discord-app-id-changed(string);
    callback discord-mixes-changed(bool);
    callback discord-radio-changed(bool);
    // The Discord worker's status line changed.
    callback discord-status-changed();
    callback minimize-to-tray-changed(bool);
    callback online-art-changed(bool);
    callback add-station();
    callback edit-station(int);
    callback delete-station(int);
    callback confirm-delete();
    callback editor-check();
    callback editor-save();
    callback import-stations();
    callback export-stations();
    // A station connected (or failed), or a check of an address finished, in the background.
    callback station-connected();
    callback probe-done();
    // Station logos found online.
    callback logos-ready();
    callback show-tab(int);
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback volume-changed(float);

    changed volume => { volume-changed(volume); }
    callback activate(int);
    callback move-selection(int);
    callback typed(string) -> bool;
    // Ctrl+J, or a click on what's playing: show it in its list.
    callback jump-to-playing();
    // A background scan has a new library waiting.
    callback library-ready();
    // Something changed in a library folder.
    callback rescan();
    callback list-view-changed();
    // Covers have been loaded in the background.
    callback covers-ready();
    // Ctrl+Q, or Quit in the tray menu.
    callback quit();
    // The tray icon was clicked or its menu used (see tray.rs Action).
    callback tray-action(int);
    // The media overlay or a media key: a media::Command code, and seconds for a seek.
    callback media-command(int, float);

    forward-focus: list;

    // Keys the focused control doesn't use itself end up here.
    FocusScope {
        key-pressed(e) => {
            if (e.text == " ") { toggle-play(); return accept; }
            if (e.modifiers.control && e.text == Key.LeftArrow) { previous(); return accept; }
            if (e.modifiers.control && e.text == Key.RightArrow) { next(); return accept; }
            // Ctrl+J shows what's playing in its list (0x0A is how some keyboards send it).
            if (e.modifiers.control && (e.text == "j" || e.text == "J" || e.text == "\u{0A}")) { jump-to-playing(); return accept; }
            // Ctrl+L loves, as in 2.x (0x0C is how some keyboards send it).
            if (e.modifiers.control && (e.text == "l" || e.text == "L" || e.text == "\u{0C}")) { toggle-love(); return accept; }
            // Some keyboards send Ctrl+Q as the control character 0x11 rather than "q".
            if (e.modifiers.control && (e.text == "q" || e.text == "Q" || e.text == "\u{11}")) { quit(); return accept; }
            reject
        }

        VerticalLayout {
            // ===== Transport =====
            Rectangle {
                background: Theme.bar;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    IconButton {
                        glyph: "\u{E892}";
                        label: "Previous";
                        size: 34px;
                        enabled: loaded && !live;
                        clicked => { previous(); }
                    }
                    IconButton {
                        glyph: !playing ? "\u{E768}" : live ? "\u{E71A}" : "\u{E769}";
                        label: !playing ? "Play" : live ? "Stop" : "Pause";
                        size: 38px;
                        glyph-size: 18px;
                        clicked => { toggle-play(); }
                    }
                    IconButton {
                        glyph: "\u{E893}";
                        label: "Next";
                        size: 34px;
                        enabled: loaded && !live;
                        clicked => { next(); }
                    }
                    Rectangle { width: 14px; }
                    seek-bar := ThinSlider {
                        enabled: loaded && !live && length > 0;
                        maximum: max(length, 1);
                        value <=> position;
                        small-step: 5;
                        large-step: 30;
                        label: "Position";
                        committed(v) => { seek(v); }
                    }
                    Rectangle { width: 12px; }
                    Text {
                        text: time-text;
                        font-family: "IBM Plex Mono";
                        font-size: 12px;
                        color: Theme.dim;
                        vertical-alignment: center;
                    }
                    Rectangle { width: 12px; }
                    if can-love: IconButton {
                        glyph: loved ? "\u{EB52}" : "\u{EB51}";
                        label: loved ? "Loved, un-love" : "Love";
                        active: loved;
                        muted: true;
                        size: 34px;
                        clicked => { toggle-love(); }
                    }
                    IconButton {
                        glyph: "\u{E8B1}";
                        label: shuffle ? "Shuffle, on" : "Shuffle, off";
                        active: shuffle;
                        muted: true;
                        size: 34px;
                        clicked => { toggle-shuffle(); }
                    }
                    IconButton {
                        glyph: repeat == 2 ? "\u{E8ED}" : "\u{E8EE}";
                        label: repeat == 0 ? "Repeat, off" : repeat == 1 ? "Repeat all" : "Repeat one";
                        active: repeat != 0;
                        muted: true;
                        size: 34px;
                        clicked => { cycle-repeat(); }
                    }
                    Rectangle { width: 10px; }
                    Text {
                        text: volume == 0 ? "\u{E74F}" : "\u{E767}";
                        font-family: "Segoe Fluent Icons";
                        font-size: 14px;
                        color: Theme.dim;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                    Rectangle { width: 8px; }
                    ThinSlider {
                        width: 96px;
                        horizontal-stretch: 0;
                        maximum: 100;
                        value <=> volume;
                        small-step: 5;
                        large-step: 10;
                        label: "Volume";
                    }
                    Rectangle { width: 10px; }
                    IconButton {
                        glyph: "\u{E713}";
                        label: "Settings";
                        muted: true;
                        size: 34px;
                        clicked => { open-settings(); }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }
            }

            // ===== Library tabs =====
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                padding-top: 4px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 6px;
                    accessible-role: tab-list;
                    TabButton {
                        text: "Music";
                        active: tab == 0;
                        clicked => { show-tab(0); }
                    }
                    TabButton {
                        text: "Mixes";
                        active: tab == 1;
                        clicked => { show-tab(1); }
                    }
                    TabButton {
                        text: "Radio";
                        active: tab == 2;
                        clicked => { show-tab(2); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                if tab == 2: TextButton {
                    glyph: "\u{E710}";
                    text: "Add station";
                    clicked => { add-station(); }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            if row-count == 0: VerticalLayout {
                alignment: center;
                spacing: 6px;
                Text {
                    text: tab == 0 ? "No music yet" : tab == 1 ? "No mixes yet" : "No stations yet";
                    font-size: 16px;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: tab == 0 ? "Point Melora at the folder where you keep your music."
                        : tab == 1 ? "Point Melora at the folder where you keep DJ sets and mixes."
                        : "Paste a stream address and give it a name before you tune in.";
                    color: Theme.dim;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding-top: 10px;
                    if tab != 2: Button {
                        text: tab == 0 ? "Add music folder…" : "Add mixes folder…";
                        clicked => { add-folder(tab); }
                    }
                    if tab == 2: Button {
                        text: "Add station…";
                        clicked => { add-station(); }
                    }
                    if tab == 2: Button {
                        text: "Import stations…";
                        clicked => { import-stations(); }
                    }
                }
            }

            list := TrackList {
                visible: row-count > 0;
                vertical-stretch: 1;
                rows: rows;
                count: row-count;
                total-height: list-height;
                view-changed => { list-view-changed(); }
                selected <=> selected;
                label: tab == 0 ? "Music" : tab == 1 ? "Mixes" : "Radio stations";
                move-selection(n) => { move-selection(n); }
                activate(i) => { activate(i); }
                typed(t) => { return typed(t); }
                edit-row(i) => { if (tab == 2) { edit-station(i); } }
                delete-row(i) => { if (tab == 2) { delete-station(i); } }
                row-menu(i, x, y) => {
                    menu-row = i;
                    menu-x = x;
                    menu-y = y;
                    station-menu.show();
                }
            }

            // ===== Status bar =====
            Rectangle {
                background: Theme.bar;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.divider;
                }
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 7px;
                    padding-bottom: 7px;
                    spacing: 16px;
                    Text {
                        text: now-playing == "" ? "Nothing playing" : now-playing;
                        font-size: 12px;
                        color: now-playing == "" ? Theme.dim : Theme.text;
                        overflow: elide;
                        horizontal-stretch: 1;
                        accessible-role: button;
                        accessible-label: now-playing == "" ? "Nothing playing" : "Show in the list: " + now-playing;
                        accessible-action-default => { jump-to-playing(); }
                        TouchArea {
                            mouse-cursor: now-playing == "" ? default : pointer;
                            clicked => { jump-to-playing(); }
                        }
                    }
                    Text {
                        text: format-text;
                        font-family: "IBM Plex Mono";
                        font-size: 11.5px;
                        color: Theme.dim;
                        vertical-alignment: center;
                    }
                    Text {
                        text: summary;
                        font-size: 12px;
                        color: Theme.dim;
                    }
                }
            }
        }
    }

    // Right-click on a station.
    station-menu := PopupWindow {
        x: menu-x;
        y: menu-y;
        Rectangle {
            background: Theme.panel;
            border-color: Theme.divider;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    text: "Play";
                    clicked => { activate(menu-row); }
                }
                MenuItem {
                    text: "Edit…   (F2)";
                    clicked => { edit-station(menu-row); }
                }
                MenuItem {
                    text: "Delete   (Del)";
                    clicked => { delete-station(menu-row); }
                }
            }
        }
    }

    if editor-open: StationEditor {
        width: root.width;
        height: root.height;
        heading: editor-heading;
        url <=> editor-url;
        name <=> editor-name;
        status: editor-status;
        status-is-error: editor-error;
        busy: editor-busy;
        check => { editor-check(); }
        save => { editor-save(); }
        cancel => { editor-open = false; }
    }

    if settings-open: SettingsPanel {
        width: root.width;
        height: root.height;
        music-folders: music-folders;
        mixes-folders: mixes-folders;
        minimize-to-tray <=> minimize-to-tray;
        online-art <=> online-art;
        version: version;
        note: settings-note;
        scrobble-mixes <=> scrobble-mixes;
        pending: pending;
        lastfm: lastfm;
        listenbrainz: listenbrainz;
        lastfm-key <=> lastfm-key;
        lastfm-secret <=> lastfm-secret;
        listenbrainz-token <=> listenbrainz-token;
        scrobble-mixes-changed(on) => { scrobble-mixes-changed(on); }
        lastfm-connect => { lastfm-connect(); }
        lastfm-disconnect => { lastfm-disconnect(); }
        listenbrainz-connect => { listenbrainz-connect(); }
        listenbrainz-disconnect => { listenbrainz-disconnect(); }
        discord-enabled <=> discord-enabled;
        discord-app-id <=> discord-app-id;
        discord-status: discord-status;
        discord-mixes <=> discord-mixes;
        discord-radio <=> discord-radio;
        discord-enabled-changed(on) => { discord-enabled-changed(on); }
        discord-app-id-changed(t) => { discord-app-id-changed(t); }
        discord-mixes-changed(on) => { discord-mixes-changed(on); }
        discord-radio-changed(on) => { discord-radio-changed(on); }
        add-folder(k) => { add-folder(k); }
        remove-folder(k, path) => { remove-folder(k, path); }
        export-stations => { export-stations(); }
        import-stations => { import-stations(); }
        minimize-to-tray-changed(on) => { minimize-to-tray-changed(on); }
        online-art-changed(on) => { online-art-changed(on); }
        done => { settings-open = false; }
        open-log => { open-log(); }
        update-enabled <=> update-enabled;
        update-status: update-status;
        update-available: update-available;
        update-enabled-changed(on) => { update-enabled-changed(on); }
        check-updates => { check-updates(); }
        open-update => { open-update(); }
    }

    if confirm-open: ConfirmPanel {
        width: root.width;
        height: root.height;
        message: confirm-message;
        confirm => { confirm-delete(); }
        cancel => { confirm-open = false; }
    }
}
