// Melora 3.0: the music library, played without gaps. Nord colours, IBM Plex Sans.
import "fonts/IBMPlexSans-Regular.ttf";
import "fonts/IBMPlexSans-SemiBold.ttf";
import { Theme } from "theme.slint";
import { IconButton, TabButton, ThinSlider } from "controls.slint";
import { Row, TrackList } from "track_list.slint";
import { Button } from "std-widgets.slint";
import { ConfirmPanel, MenuItem, StationEditor } from "dialogs.slint";

export { Row }

export component AppWindow inherits Window {
    title: "Melora";
    preferred-width: 820px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 320px;
    background: Theme.background;
    default-font-family: "IBM Plex Sans";
    default-font-size: 13px;

    in property <string> track-title: "Nothing playing";
    in property <string> track-detail;
    in property <bool> playing;
    in property <bool> loaded;
    in property <float> length;
    in-out property <float> position;
    in property <string> time-text;
    // The rows in view, and the whole list's size (see TrackList).
    in property <[Row]> rows;
    in property <int> row-count;
    in property <length> list-height;
    in-out property <int> selected: -1;
    in-out property <length> list-scroll <=> list.scroll-y;
    out property <length> list-view-height: list.view-height;
    // "1,234 tracks · 3d 4h", or what a scan is doing.
    in property <string> summary;
    // 0 Music, 1 Mixes.
    in property <int> tab;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    // 0 to 100.
    in-out property <float> volume: 100;
    // While the seek bar is being dragged, playback mustn't move it back.
    out property <bool> seeking: seek-bar.dragging;

    // Radio: the station editor and the delete confirmation (set by Rust).
    in-out property <bool> editor-open;
    in property <string> editor-heading;
    in-out property <string> editor-url;
    in-out property <string> editor-name;
    in property <string> editor-status;
    in property <bool> editor-error;
    in property <bool> editor-busy;
    in-out property <bool> confirm-open;
    in property <string> confirm-message;
    property <int> menu-row: -1;
    property <length> menu-x;
    property <length> menu-y;

    callback add-folder();
    callback add-station();
    callback edit-station(int);
    callback delete-station(int);
    callback confirm-delete();
    callback editor-check();
    callback editor-save();
    callback import-stations();
    callback export-stations();
    // A station connected (or failed), or a check of an address finished, in the background.
    callback station-connected();
    callback probe-done();
    callback show-tab(int);
    callback toggle-play();
    callback previous();
    callback next();
    callback seek(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    callback volume-changed(float);

    changed volume => { volume-changed(volume); }
    callback activate(int);
    callback move-selection(int);
    // A background scan has a new library waiting.
    callback library-ready();
    // Something changed in a library folder.
    callback rescan();
    callback list-view-changed();
    // Covers have been loaded in the background.
    callback covers-ready();

    forward-focus: list;

    // Keys the focused control doesn't use itself end up here.
    FocusScope {
        key-pressed(e) => {
            if (e.text == " ") { toggle-play(); return accept; }
            if (e.modifiers.control && e.text == Key.LeftArrow) { previous(); return accept; }
            if (e.modifiers.control && e.text == Key.RightArrow) { next(); return accept; }
            reject
        }

        VerticalLayout {
            VerticalLayout {
                padding: 20px;
                padding-bottom: 12px;
                spacing: 4px;
                Text {
                    text: track-title;
                    font-size: 20px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: track-detail;
                    color: Theme.dim;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 20px;
                padding-bottom: 12px;
                spacing: 4px;
                IconButton {
                    glyph: "\u{E892}";
                    label: "Previous";
                    enabled: loaded;
                    clicked => { previous(); }
                }
                IconButton {
                    glyph: playing ? "\u{E769}" : "\u{E768}";
                    label: playing ? "Pause" : "Play";
                    size: 44px;
                    clicked => { toggle-play(); }
                }
                IconButton {
                    glyph: "\u{E893}";
                    label: "Next";
                    enabled: loaded;
                    clicked => { next(); }
                }
                seek-bar := ThinSlider {
                    enabled: loaded;
                    maximum: max(length, 1);
                    value <=> position;
                    small-step: 5;
                    large-step: 30;
                    label: "Position";
                    committed(v) => { seek(v); }
                }
                Text {
                    text: time-text;
                    color: Theme.dim;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    min-width: 96px;
                }
                Rectangle { width: 8px; }
                IconButton {
                    glyph: "\u{E8B1}";
                    label: shuffle ? "Shuffle, on" : "Shuffle, off";
                    active: shuffle;
                    size: 36px;
                    clicked => { toggle-shuffle(); }
                }
                IconButton {
                    glyph: repeat == 2 ? "\u{E8ED}" : "\u{E8EE}";
                    label: repeat == 0 ? "Repeat, off" : repeat == 1 ? "Repeat all" : "Repeat one";
                    active: repeat != 0;
                    size: 36px;
                    clicked => { cycle-repeat(); }
                }
                Text {
                    text: volume == 0 ? "\u{E74F}" : "\u{E767}";
                    font-family: "Segoe Fluent Icons";
                    font-size: 15px;
                    color: Theme.dim;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                ThinSlider {
                    width: 96px;
                    horizontal-stretch: 0;
                    maximum: 100;
                    value <=> volume;
                    small-step: 5;
                    large-step: 20;
                    label: "Volume";
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 4px;
                    accessible-role: tab-list;
                    TabButton {
                        text: "Music";
                        active: tab == 0;
                        clicked => { show-tab(0); }
                    }
                    TabButton {
                        text: "Mixes";
                        active: tab == 1;
                        clicked => { show-tab(1); }
                    }
                    TabButton {
                        text: "Radio";
                        active: tab == 2;
                        clicked => { show-tab(2); }
                    }
                }
                Text {
                    text: summary;
                    color: Theme.dim;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if tab != 2: IconButton {
                    glyph: "\u{E8F4}";
                    label: tab == 0 ? "Add music folder" : "Add mixes folder";
                    size: 36px;
                    clicked => { add-folder(); }
                }
                if tab == 2: IconButton {
                    glyph: "\u{E710}";
                    label: "Add station";
                    size: 36px;
                    clicked => { add-station(); }
                }
                if tab == 2: more := IconButton {
                    glyph: "\u{E712}";
                    label: "More: import or export stations";
                    size: 36px;
                    clicked => {
                        stations-menu.show();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.divider;
            }

            if row-count == 0: VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: tab == 0 ? "No music yet" : tab == 1 ? "No mixes yet" : "No stations yet";
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
                Text {
                    text: tab == 0 ? "Add a folder with the button at the top right."
                        : tab == 1 ? "Add the folder where you keep DJ sets and mixes, with the button at the top right."
                        : "Paste a stream address and give it a name before you tune in.";
                    color: Theme.dim;
                    horizontal-alignment: center;
                }
                if tab == 2: HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding-top: 8px;
                    Button {
                        text: "Add station…";
                        clicked => { add-station(); }
                    }
                    Button {
                        text: "Import stations…";
                        clicked => { import-stations(); }
                    }
                }
            }

            list := TrackList {
                visible: row-count > 0;
                vertical-stretch: 1;
                rows: rows;
                count: row-count;
                total-height: list-height;
                view-changed => { list-view-changed(); }
                selected <=> selected;
                label: tab == 0 ? "Music" : tab == 1 ? "Mixes" : "Radio stations";
                move-selection(n) => { move-selection(n); }
                activate(i) => { activate(i); }
                edit-row(i) => { if (tab == 2) { edit-station(i); } }
                delete-row(i) => { if (tab == 2) { delete-station(i); } }
                row-menu(i, x, y) => {
                    menu-row = i;
                    menu-x = x;
                    menu-y = y;
                    station-menu.show();
                }
            }
        }
    }

    // Right-click on a station.
    station-menu := PopupWindow {
        x: menu-x;
        y: menu-y;
        Rectangle {
            background: Theme.panel;
            border-color: Theme.divider;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    text: "Play";
                    clicked => { activate(menu-row); }
                }
                MenuItem {
                    text: "Edit…   (F2)";
                    clicked => { edit-station(menu-row); }
                }
                MenuItem {
                    text: "Delete   (Del)";
                    clicked => { delete-station(menu-row); }
                }
            }
        }
    }

    // The ⋯ button next to Add station.
    stations-menu := PopupWindow {
        x: root.width - 200px;
        y: 150px;
        Rectangle {
            background: Theme.panel;
            border-color: Theme.divider;
            border-width: 1px;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                MenuItem {
                    text: "Export stations…";
                    clicked => { export-stations(); }
                }
                MenuItem {
                    text: "Import stations…";
                    clicked => { import-stations(); }
                }
            }
        }
    }

    if editor-open: StationEditor {
        width: root.width;
        height: root.height;
        heading: editor-heading;
        url <=> editor-url;
        name <=> editor-name;
        status: editor-status;
        status-is-error: editor-error;
        busy: editor-busy;
        check => { editor-check(); }
        save => { editor-save(); }
        cancel => { editor-open = false; }
    }

    if confirm-open: ConfirmPanel {
        width: root.width;
        height: root.height;
        message: confirm-message;
        confirm => { confirm-delete(); }
        cancel => { confirm-open = false; }
    }
}
