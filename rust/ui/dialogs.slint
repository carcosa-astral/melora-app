// In-window panels: adding or editing a radio station, confirming a delete, and small menus.
// They cover the window in its own background colour (solid, no see-through scrim).
import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component Panel inherits Rectangle {
    callback cancel();
    background: Theme.background;
    // Clicks don't reach the list underneath.
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { cancel(); return accept; }
            reject
        }
        Rectangle {
            width: min(500px, root.width - 32px);
            height: body.preferred-height;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.divider;
            background: Theme.panel;
            body := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                @children
            }
        }
    }
}

// Add or edit a station: paste the address, Check it (which also reads the name the station
// gives itself), name it, Save. As in 2.x's station window.
export component StationEditor inherits Panel {
    in property <string> heading;
    in-out property <string> url;
    in-out property <string> name;
    in property <string> status;
    in property <bool> status-is-error;
    in property <bool> busy;
    callback check();
    callback save();

    Text {
        text: heading;
        font-size: 18px;
        font-weight: 600;
        color: Theme.text;
    }
    Text {
        text: "Stream address";
        color: Theme.dim;
    }
    HorizontalLayout {
        spacing: 8px;
        url-edit := LineEdit {
            text <=> root.url;
            placeholder-text: "Paste an address (.pls, .m3u and HLS .m3u8 work too)";
            accessible-label: "Stream address";
            accepted => { check(); }
        }
        Button {
            text: busy ? "Checking…" : "Check";
            enabled: !busy;
            clicked => { check(); }
        }
    }
    Text {
        text: status;
        color: status-is-error ? Theme.error : Theme.dim;
        wrap: word-wrap;
    }
    Text {
        text: "Name";
        color: Theme.dim;
    }
    LineEdit {
        text <=> root.name;
        accessible-label: "Name";
        accepted => { save(); }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 6px;
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        Button {
            text: "Save";
            primary: true;
            clicked => { save(); }
        }
    }

    init => { url-edit.focus(); }
}

// "Delete Groove Salad?" with Delete and Cancel.
export component ConfirmPanel inherits Panel {
    in property <string> message;
    in property <string> action: "Delete";
    callback confirm();

    Text {
        text: message;
        font-size: 16px;
        font-weight: 600;
        color: Theme.text;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        padding-top: 6px;
        cancel-button := Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }
        Button {
            text: action;
            primary: true;
            clicked => { confirm(); }
        }
    }

    init => { cancel-button.focus(); }
}

// A line in a small popup menu.
export component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    min-width: 160px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.divider : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Text {
        x: 12px;
        text: root.text;
        color: Theme.text;
        vertical-alignment: center;
    }
}

// One folder in a Settings list, with its Remove button.
component FolderRow inherits Rectangle {
    in property <string> path;
    callback remove();
    height: 34px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: path;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Button {
            text: "Remove";
            accessible-label: "Remove " + path;
            clicked => { remove(); }
        }
    }
}

// A scrobbling service's state in Settings.
export struct Account {
    connected: bool,
    // "Connected as griff", or why it needs connecting again.
    status: string,
    // What Connect is doing, or why it didn't work.
    message: string,
    busy: bool,
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
    color: Theme.text;
}

component Hint inherits Text {
    font-size: 12px;
    color: Theme.dim;
    wrap: word-wrap;
}

// Settings, as in 2.x: the library folders, backing up the radio stations, the window, looking
// things up online, and about. It covers the window; Done or Escape closes it.
export component SettingsPanel inherits Rectangle {
    in property <[string]> music-folders;
    in property <[string]> mixes-folders;
    in-out property <bool> minimize-to-tray;
    in-out property <bool> online-art;
    in property <string> version;
    in property <string> note;
    // Scrobbling.
    in-out property <bool> scrobble-mixes;
    in property <string> pending;
    in property <Account> lastfm;
    in property <Account> listenbrainz;
    in-out property <string> lastfm-key;
    in-out property <string> lastfm-secret;
    in-out property <string> listenbrainz-token;
    callback scrobble-mixes-changed(bool);
    callback lastfm-connect();
    callback lastfm-disconnect();
    callback listenbrainz-connect();
    callback listenbrainz-disconnect();
    // Discord.
    in-out property <bool> discord-enabled;
    in-out property <string> discord-app-id;
    in property <string> discord-status;
    in-out property <bool> discord-mixes;
    in-out property <bool> discord-radio;
    callback discord-enabled-changed(bool);
    callback discord-app-id-changed(string);
    callback discord-mixes-changed(bool);
    callback discord-radio-changed(bool);
    callback add-folder(int);              // 0 Music, 1 Mixes
    callback remove-folder(int, string);
    callback export-stations();
    callback import-stations();
    callback minimize-to-tray-changed(bool);
    callback online-art-changed(bool);
    callback done();

    background: Theme.background;
    TouchArea { }
    FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { done(); return accept; }
            reject
        }
        VerticalLayout {
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 16px;
                padding-top: 12px;
                padding-bottom: 12px;
                Text {
                    text: "Settings";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                done-button := Button {
                    text: "Done";
                    primary: true;
                    clicked => { done(); }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            ScrollView {
                vertical-stretch: 1;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(620px, root.width - 48px);
                        padding-top: 20px;
                        padding-bottom: 32px;
                        spacing: 8px;

                        if note != "": Text {
                            text: note;
                            color: Theme.accent;
                            wrap: word-wrap;
                        }

                        Heading { text: "Music folders"; }
                        if music-folders.length == 0: Hint { text: "None yet."; }
                        for f in music-folders: FolderRow {
                            path: f;
                            remove => { remove-folder(0, f); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add folder…";
                                accessible-label: "Add music folder";
                                clicked => { add-folder(0); }
                            }
                        }

                        Rectangle { height: 16px; }
                        Heading { text: "Mixes folders"; }
                        Hint { text: "Where you keep DJ sets and mixes. A mixes folder inside a music folder only shows up in Mixes."; }
                        if mixes-folders.length == 0: Hint { text: "None yet."; }
                        for f in mixes-folders: FolderRow {
                            path: f;
                            remove => { remove-folder(1, f); }
                        }
                        HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Add folder…";
                                accessible-label: "Add mixes folder";
                                clicked => { add-folder(1); }
                            }
                        }

                        Rectangle { height: 16px; }
                        Heading { text: "Radio stations"; }
                        Hint { text: "Back up your stations to an .m3u file (other players can open it too), or restore them from one. Stations you already have are skipped."; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Button {
                                text: "Back up stations…";
                                clicked => { export-stations(); }
                            }
                            Button {
                                text: "Restore stations…";
                                clicked => { import-stations(); }
                            }
                        }

                        Rectangle { height: 16px; }
                        Heading { text: "Window"; }
                        CheckBox {
                            text: "Minimizing sends Melora to the system tray";
                            checked <=> minimize-to-tray;
                            toggled => { minimize-to-tray-changed(self.checked); }
                        }

                        Rectangle { height: 16px; }
                        Heading { text: "Online"; }
                        CheckBox {
                            text: "Find missing covers, DJ pictures and station logos online";
                            checked <=> online-art;
                            toggled => { online-art-changed(self.checked); }
                        }
                        Hint { text: "Station logos come from Radio Browser. Turning this off also hides the ones already found."; }

                        Rectangle { height: 16px; }
                        Heading { text: "Scrobbling"; }
                        Hint { text: "A play counts once you've listened to half of it or 4 minutes, whichever comes first. Tracks of 30 seconds or less and radio aren't scrobbled. Plays wait in Melora while you're offline."; }
                        CheckBox {
                            text: "Scrobble mixes too";
                            checked <=> scrobble-mixes;
                            toggled => { scrobble-mixes-changed(self.checked); }
                        }
                        if pending != "": Hint { text: pending; }

                        Rectangle { height: 6px; }
                        Text {
                            text: "Last.fm";
                            font-weight: 600;
                            color: Theme.text;
                        }
                        if lastfm.status != "": Hint { text: lastfm.status; }
                        if lastfm.connected: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Disconnect";
                                accessible-label: "Disconnect Last.fm";
                                clicked => { lastfm-disconnect(); }
                            }
                        }
                        if !lastfm.connected: VerticalLayout {
                            spacing: 6px;
                            Hint { text: "Make an API account at last.fm/api/account/create (any name works), then paste its key and shared secret here."; }
                            LineEdit {
                                text <=> root.lastfm-key;
                                placeholder-text: "API key";
                                accessible-label: "Last.fm API key";
                            }
                            LineEdit {
                                text <=> root.lastfm-secret;
                                placeholder-text: "Shared secret";
                                input-type: password;
                                accessible-label: "Last.fm shared secret";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Connect…";
                                    accessible-label: "Connect Last.fm";
                                    enabled: !lastfm.busy;
                                    clicked => { lastfm-connect(); }
                                }
                            }
                        }
                        if lastfm.message != "": Hint { text: lastfm.message; }

                        Rectangle { height: 6px; }
                        Text {
                            text: "ListenBrainz";
                            font-weight: 600;
                            color: Theme.text;
                        }
                        if listenbrainz.status != "": Hint { text: listenbrainz.status; }
                        if listenbrainz.connected: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: "Disconnect";
                                accessible-label: "Disconnect ListenBrainz";
                                clicked => { listenbrainz-disconnect(); }
                            }
                        }
                        if !listenbrainz.connected: VerticalLayout {
                            spacing: 6px;
                            Hint { text: "Your user token is on listenbrainz.org/settings."; }
                            LineEdit {
                                text <=> root.listenbrainz-token;
                                placeholder-text: "User token";
                                input-type: password;
                                accessible-label: "ListenBrainz user token";
                            }
                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: "Connect";
                                    accessible-label: "Connect ListenBrainz";
                                    enabled: !listenbrainz.busy;
                                    clicked => { listenbrainz-connect(); }
                                }
                            }
                        }
                        if listenbrainz.message != "": Hint { text: listenbrainz.message; }
                        Hint { text: "Keys and tokens are kept in Melora's data folder, next to Melora.exe."; }

                        Rectangle { height: 16px; }
                        Heading { text: "Discord"; }
                        CheckBox {
                            text: "Show what I'm playing on my Discord profile";
                            checked <=> discord-enabled;
                            toggled => { discord-enabled-changed(self.checked); }
                        }
                        if discord-enabled: VerticalLayout {
                            spacing: 6px;
                            Hint { text: "Make an application at discord.com/developers/applications (its name shows after \"Listening to\"), and paste its Application ID here."; }
                            LineEdit {
                                text <=> root.discord-app-id;
                                placeholder-text: "Application ID";
                                accessible-label: "Discord application ID";
                                edited(t) => { discord-app-id-changed(t); }
                            }
                            if discord-status != "": Hint { text: discord-status; }
                            CheckBox {
                                text: "Show mixes";
                                checked <=> discord-mixes;
                                toggled => { discord-mixes-changed(self.checked); }
                            }
                            CheckBox {
                                text: "Show radio";
                                checked <=> discord-radio;
                                toggled => { discord-radio-changed(self.checked); }
                            }
                            Hint { text: "Discord can only show pictures from the web, so album covers are looked up on the Cover Art Archive, iTunes and Deezer, and DJ photos on Deezer. Nothing is looked up while this is off. Nothing shows while paused."; }
                        }

                        Rectangle { height: 16px; }
                        Heading { text: "About"; }
                        Hint { text: version; }
                    }
                }
            }
        }
    }

    init => { done-button.focus(); }
}
