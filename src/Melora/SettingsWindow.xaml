<Window x:Class="Melora.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Melora"
        Title="Settings"
        Width="600" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,10" />
        </Style>
        <Style x:Key="ServiceName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,10,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BarBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Button Style="{StaticResource TextButton}" Content="Done" IsDefault="True" IsCancel="True"
                    HorizontalAlignment="Right" Click="OnDone" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,20">
                <local:FolderSection x:Name="MusicSection" />
                <local:FolderSection x:Name="MixesSection" Margin="0,28,0,0" />

                <TextBlock Text="Window" Style="{StaticResource Heading}" />
                <CheckBox Content="Minimizing sends Melora to the system tray" IsChecked="{Binding MinimizeToTray}" />
                <CheckBox Content="Tint Melora with colours from the playing album's art" IsChecked="{Binding AccentFromArt}"
                          Margin="0,10,0,0" />
                <CheckBox Content="Show covers for songs on the radio" IsChecked="{Binding RadioCovers}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="28,4,0,0"
                           Text="Looked up on iTunes and Deezer by artist and song name, as stations don't send pictures." />

                <!-- ===== Scrobbling ===== -->
                <TextBlock Text="Scrobbling" Style="{StaticResource Heading}" />
                <TextBlock Style="{StaticResource Hint}"
                           Text="A play counts once you've listened to half of it or 4 minutes, whichever comes first. Tracks under 30 seconds and radio are never sent. Plays made offline are kept and sent later." />
                <CheckBox Content="Scrobble mixes too" IsChecked="{Binding Scrobbler.ScrobbleMixes}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Scrobbler.PendingText}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Foreground="{DynamicResource AccentBrush}" />

                <!-- Last.fm -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="LastFmDisconnect" DockPanel.Dock="Right" Style="{StaticResource TextButton}"
                                    Content="Disconnect" Padding="10,4" Click="OnLastFmDisconnect" />
                            <StackPanel>
                                <TextBlock Text="Last.fm" Style="{StaticResource ServiceName}" />
                                <TextBlock x:Name="LastFmStatus" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel x:Name="LastFmSetup">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                                Last.fm needs your own API key. Create one for free at
                                <Hyperlink NavigateUri="https://www.last.fm/api/account/create" RequestNavigate="OnLink"
                                           Foreground="{DynamicResource AccentBrush}">last.fm/api/account/create</Hyperlink>
                                (any application name will do), then paste the key and secret here.
                            </TextBlock>
                            <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="LastFmKey" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <TextBlock Text="Shared secret" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="LastFmSecret" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <DockPanel Margin="0,12,0,0">
                                <Button x:Name="LastFmConnect" Style="{StaticResource TextButton}" Content="Connect…"
                                        Click="OnLastFmConnect" />
                                <TextBlock x:Name="LastFmMessage" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ListenBrainz -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="ListenBrainzDisconnect" DockPanel.Dock="Right" Style="{StaticResource TextButton}"
                                    Content="Disconnect" Padding="10,4" Click="OnListenBrainzDisconnect" />
                            <StackPanel>
                                <TextBlock Text="ListenBrainz" Style="{StaticResource ServiceName}" />
                                <TextBlock x:Name="ListenBrainzStatus" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <StackPanel x:Name="ListenBrainzSetup">
                            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                                Copy your user token from
                                <Hyperlink NavigateUri="https://listenbrainz.org/settings/" RequestNavigate="OnLink"
                                           Foreground="{DynamicResource AccentBrush}">listenbrainz.org/settings</Hyperlink>
                                and paste it here.
                            </TextBlock>
                            <TextBlock Text="User token" Style="{StaticResource FieldLabel}" />
                            <PasswordBox x:Name="ListenBrainzToken" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <DockPanel Margin="0,12,0,0">
                                <Button x:Name="ListenBrainzConnect" Style="{StaticResource TextButton}" Content="Connect"
                                        Click="OnListenBrainzConnect" />
                                <TextBlock x:Name="ListenBrainzMessage" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,12,0,0"
                           Text="Keys and tokens are kept in Melora's data folder, next to Melora.exe." />

                <!-- ===== Discord ===== -->
                <TextBlock Text="Discord" Style="{StaticResource Heading}" />
                <CheckBox Content="Show what I'm playing on my Discord profile" IsChecked="{Binding Discord.Enabled}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Discord.Enabled}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}">
                            Discord needs an application to show as “Listening to …”. Create one at
                            <Hyperlink NavigateUri="https://discord.com/developers/applications" RequestNavigate="OnLink"
                                       Foreground="{DynamicResource AccentBrush}">discord.com/developers/applications</Hyperlink>
                            and name it Melora (the name is what people see), then copy its Application ID here.
                        </TextBlock>
                        <TextBlock Text="Application ID" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Discord.ApplicationId, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        <TextBlock Text="{Binding Discord.Status}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <CheckBox Content="Show mixes" IsChecked="{Binding Discord.ShowMixes}" Margin="0,12,0,0" />
                        <CheckBox Content="Show radio" IsChecked="{Binding Discord.ShowRadio}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,12,0,0"
                           Text="Discord can only show pictures from the web, so album covers are looked up on the Cover Art Archive, iTunes and Deezer by artist and album name. Nothing is sent while this is off." />

                <!-- ===== About ===== -->
                <TextBlock Text="About" Style="{StaticResource Heading}" />
                <TextBlock FontSize="14" FontWeight="SemiBold"
                           Text="{Binding Source={x:Static local:UpdateCheck.CurrentVersion}, StringFormat='Melora {0}', Mode=OneTime}" />
                <CheckBox Content="Check GitHub for new versions (once a day)" IsChecked="{Binding Updates.Enabled}" Margin="0,12,0,0" />
                <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Check now" Padding="10,4"
                            IsEnabled="{Binding Updates.Enabled}" Click="OnCheckUpdates" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Hint}" Text="{Binding Updates.Status}" />
                        <!-- Only when there's something newer: a link to its release page. -->
                        <TextBlock Style="{StaticResource Hint}" Margin="6,0,0,0"
                                   Visibility="{Binding Updates.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <Hyperlink NavigateUri="{Binding Updates.ReleaseUrl}" RequestNavigate="OnLink"
                                       Foreground="{DynamicResource AccentBrush}">Download</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,10,0,0">
                    Melora never downloads or installs updates itself: replace <Run FontFamily="{StaticResource MonoFont}">Melora.exe</Run>
                    with the new one and keep your <Run FontFamily="{StaticResource MonoFont}">data</Run> folder.
                    <Hyperlink NavigateUri="https://github.com/carcosa-astral/melora-app/releases" RequestNavigate="OnLink"
                               Foreground="{DynamicResource AccentBrush}">All releases</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
