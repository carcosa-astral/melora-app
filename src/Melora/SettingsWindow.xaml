<Window x:Class="Melora.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="560" Height="400" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        xmlns:local="clr-namespace:Melora"
        UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Music folders" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="Melora watches these folders and picks up new or changed files on its own." />

        <ListBox x:Name="FolderList" Grid.Row="2" Background="{StaticResource BarBrush}" BorderThickness="0"
                 Foreground="{StaticResource TextBrush}" Padding="4"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Done" IsDefault="True"
                    IsCancel="True" Click="OnDone" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource TextButton}" Content="Add folder…" Click="OnAdd" />
                <Button Style="{StaticResource TextButton}" Content="Remove" Margin="8,0,0,0" Click="OnRemove"
                        IsEnabled="{Binding SelectedItem, ElementName=FolderList, Converter={x:Static local:NotNullConverter.Instance}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
