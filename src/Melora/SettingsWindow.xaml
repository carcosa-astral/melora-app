<Window x:Class="Melora.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Melora"
        Title="Settings"
        Width="580" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <StackPanel Margin="24">
        <local:FolderSection x:Name="MusicSection" />
        <local:FolderSection x:Name="MixesSection" Margin="0,28,0,0" />

        <TextBlock Text="Window" FontSize="16" FontWeight="SemiBold" Margin="0,28,0,10" />
        <CheckBox Content="Closing the window keeps Melora running in the tray" IsChecked="{Binding CloseToTray}" />
        <CheckBox Content="Minimizing sends Melora to the tray" IsChecked="{Binding MinimizeToTray}" Margin="0,10,0,0" />

        <Button Style="{StaticResource TextButton}" Content="Done" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,24,0,0" Click="OnDone" />
    </StackPanel>
</Window>
