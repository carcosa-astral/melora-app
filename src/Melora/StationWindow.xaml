<Window x:Class="Melora.StationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add station"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" Text="Add a station" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,18" TextWrapping="Wrap"
                   Text="Paste the stream address, check it, then give it a name you'll recognise." />

        <TextBlock Text="Stream address" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,0,0,6" />
        <DockPanel>
            <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Check"
                    Margin="8,0,0,0" Click="OnCheck" />
            <TextBox x:Name="UrlBox" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     TextChanged="OnTextChanged" KeyDown="OnUrlKeyDown" />
        </DockPanel>
        <TextBlock x:Name="CheckStatus" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDimBrush}" Text=" " />

        <TextBlock Text="Name" Foreground="{StaticResource TextDimBrush}" FontSize="12" Margin="0,14,0,6" />
        <TextBox x:Name="NameBox" TextChanged="OnTextChanged" />

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Save"
                    IsDefault="True" IsEnabled="False" Margin="8,0,0,0" Click="OnSave" />
            <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Cancel" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
