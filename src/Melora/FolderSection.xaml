<UserControl x:Class="Melora.FolderSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Melora">
    <StackPanel>
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="Hint" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,10" TextWrapping="Wrap" />

        <ListBox x:Name="FolderList" Background="{StaticResource BarBrush}" BorderThickness="0"
                 Foreground="{StaticResource TextBrush}" Padding="4" MinHeight="44" MaxHeight="150"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource TextButton}" Content="Add folder…" Click="OnAdd" />
            <Button Style="{StaticResource TextButton}" Content="Remove" Margin="8,0,0,0" Click="OnRemove"
                    IsEnabled="{Binding SelectedItem, ElementName=FolderList, Converter={x:Static local:NotNullConverter.Instance}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
