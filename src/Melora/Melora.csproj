<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Melora</RootNamespace>
    <AssemblyName>Melora</AssemblyName>
    <Version>0.2.0</Version>
    <Product>Melora</Product>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="3.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.13" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- IBM Plex, embedded so the portable build looks the same on any PC. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native BASS libraries (x64) from un4seen.com, copied next to Melora.exe. -->
    <None Include="..\..\lib\bass\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
