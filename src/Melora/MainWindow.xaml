<Window x:Class="Melora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lib="clr-namespace:Melora.Library"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <Style x:Key="TrackItem" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <EventSetter Event="MouseDoubleClick" Handler="OnTrackDoubleClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,0" Height="28">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TrackRow" DataType="{x:Type lib:Track}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="0.6*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="No" Text="{Binding TrackNoText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding LengthText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="No" Property="Text" Value="&#xE768;" />
                    <Setter TargetName="No" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="No" Property="FontSize" Value="10" />
                    <Setter TargetName="No" Property="Foreground" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Transport ===== -->
        <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (Ctrl+Left)" Click="OnPrevious" />
                    <Button Style="{StaticResource IconButton}" Click="OnPlayPause" Width="38" Height="38" FontSize="18">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Setter Property="ToolTip" Value="Play (Space)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                            <Setter Property="ToolTip" Value="Pause (Space)" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (Ctrl+Right)" Click="OnNext" />
                </StackPanel>

                <Slider x:Name="SeekBar" Grid.Column="1" Margin="18,0,14,0" Style="{StaticResource ThinSlider}"
                        Minimum="0" Maximum="{Binding Length}" Value="{Binding Position}"
                        PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" />

                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding Shuffle}" ToolTip="Shuffle">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE8B1;" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="{Binding RepeatGlyph}" ToolTip="{Binding RepeatTip}" Click="OnRepeat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RepeatActive}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <Slider Width="96" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                            Value="{Binding Volume}" ToolTip="Volume" />
                </StackPanel>

                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                        Margin="12,0,0,0" Click="OnSettings" />
            </Grid>
        </Border>

        <!-- ===== Library tabs ===== -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,4,20,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Music" IsChecked="True" GroupName="Library" />
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Mixes" GroupName="Library" IsEnabled="False"
                                 ToolTip="Coming in milestone 2" />
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Radio" GroupName="Library" IsEnabled="False"
                                 ToolTip="Coming in milestone 2" />
                </StackPanel>
                <TextBlock Text="Scanning…" Foreground="{StaticResource TextFaintBrush}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
        </Border>

        <!-- ===== Track list, grouped by album ===== -->
        <ListView x:Name="TrackList" Grid.Row="2"
                  ItemsSource="{Binding TracksView}"
                  ItemTemplate="{StaticResource TrackRow}"
                  ItemContainerStyle="{StaticResource TrackItem}"
                  Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Grid Margin="20,20,16,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="168" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="168" Height="168" VerticalAlignment="Top" CornerRadius="6"
                                                    Background="{StaticResource ArtPlaceholderBrush}">
                                                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Width="168" Height="168" VerticalAlignment="Top" CornerRadius="6">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Name.Art}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Name.Title}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" Margin="8,2,0,0" />
                                                <TextBlock Text="{Binding Name.Subtitle}" Foreground="{StaticResource TextDimBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="8,2,0,10" />
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
        </ListView>

        <!-- ===== Empty state ===== -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Your music library is empty" FontSize="16" HorizontalAlignment="Center" />
            <TextBlock Text="Add a folder and Melora will keep it in sync." Foreground="{StaticResource TextDimBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,16" />
            <Button Style="{StaticResource TextButton}" Content="Add music folder…" HorizontalAlignment="Center"
                    Click="OnAddFolder" />
        </StackPanel>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource TextFaintBrush}"
                           FontSize="12" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding FormatText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0" />
                <TextBlock Text="{Binding NowPlaying}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
