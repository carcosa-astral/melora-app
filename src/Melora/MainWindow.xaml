<Window x:Class="Melora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Melora"
        xmlns:lib="clr-namespace:Melora.Library"
        xmlns:radio="clr-namespace:Melora.Radio"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowFallbackBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <!-- Column widths shared by each list's header and rows; saved between runs. -->
        <local:ColumnLayout x:Key="MusicColumns" />
        <local:ColumnLayout x:Key="MixColumns" Length="80" />

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- A draggable divider straddling the left edge of a header column. -->
        <Style x:Key="ColumnDivider" TargetType="Thumb">
            <Setter Property="Width" Value="9" />
            <Setter Property="Margin" Value="-5,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border x:Name="Line" Width="1" Margin="0,3" Background="{StaticResource DividerBrush}"
                                    HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{StaticResource TextDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shared row chrome for all three lists. -->
        <Style x:Key="RowItem" TargetType="ListViewItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="8,0"
                                MinHeight="{TemplateBinding MinHeight}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrackItem" TargetType="ListViewItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="MinHeight" Value="28" />
            <EventSetter Event="MouseDoubleClick" Handler="OnTrackDoubleClick" />
        </Style>

        <Style x:Key="MixItem" TargetType="ListViewItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="MinHeight" Value="34" />
            <EventSetter Event="MouseDoubleClick" Handler="OnTrackDoubleClick" />
        </Style>

        <ContextMenu x:Key="TrayMenu">
            <MenuItem Header="{Binding NowPlaying}" IsEnabled="False" />
            <Separator />
            <MenuItem Header="{Binding PlayPauseLabel}" Click="OnPlayPause" />
            <MenuItem Header="Next" Click="OnNext" />
            <MenuItem Header="Previous" Click="OnPrevious" />
            <Separator />
            <MenuItem Header="Show Melora" Click="OnTrayShow" />
            <MenuItem Header="Quit" InputGestureText="Ctrl+Q" Click="OnTrayQuit" />
        </ContextMenu>

        <ContextMenu x:Key="StationMenu">
            <MenuItem Header="Play" Click="OnStationMenuPlay" />
            <MenuItem Header="Edit…" InputGestureText="F2" Click="OnStationMenuEdit" />
            <MenuItem Header="Delete" InputGestureText="Del" Click="OnStationMenuDelete" />
        </ContextMenu>

        <Style x:Key="StationItem" TargetType="ListViewItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="ContextMenu" Value="{StaticResource StationMenu}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnStationDoubleClick" />
        </Style>

        <Style x:Key="ListBase" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        </Style>

        <!-- Music: one row per track inside its album group. -->
        <DataTemplate x:Key="TrackRow" DataType="{x:Type lib:Track}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding ArtistWidth, Source={StaticResource MusicColumns}}" />
                    <ColumnDefinition Width="{Binding LengthWidth, Source={StaticResource MusicColumns}}" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="No" Text="{Binding TrackNoText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding LengthText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="No" Property="Text" Value="&#xE768;" />
                    <Setter TargetName="No" Property="FontFamily" Value="{StaticResource IconFont}" />
                    <Setter TargetName="No" Property="FontSize" Value="10" />
                    <Setter TargetName="No" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Mixes: plain rows under their DJ's heading (the picture is on the heading). -->
        <DataTemplate x:Key="MixRow" DataType="{x:Type lib:Track}">
            <!-- Indented to line up with the DJ name beside the heading's picture. -->
            <Grid Margin="56,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding ArtistWidth, Source={StaticResource MixColumns}}" />
                    <ColumnDefinition Width="{Binding LengthWidth, Source={StaticResource MixColumns}}" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                           Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding LengthText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Radio: the name you gave it, and what it's playing (or its host). -->
        <DataTemplate x:Key="StationRow" DataType="{x:Type radio:Station}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left"
                        Background="{StaticResource ArtPlaceholderBrush}">
                    <TextBlock x:Name="Glyph" Text="&#xE93E;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- The cover of the song playing, when one was found; covers the radio glyph. -->
                <Border x:Name="Cover" Width="36" Height="36" CornerRadius="18" HorizontalAlignment="Left"
                        Visibility="Collapsed">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Art, Converter={x:Static local:NotNullConverter.Instance}}" Value="True">
                    <Setter TargetName="Cover" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Transport ===== -->
        <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous (Ctrl+Left)" Click="OnPrevious" />
                    <Button Style="{StaticResource IconButton}" Click="OnPlayPause" Width="38" Height="38" FontSize="18">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE768;" />
                                    <Setter Property="ToolTip" Value="Play (Space)" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="&#xE769;" />
                                            <Setter Property="ToolTip" Value="Pause (Space)" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPlaying}" Value="True" />
                                                <Condition Binding="{Binding IsLive}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="&#xE71A;" />
                                            <Setter Property="ToolTip" Value="Stop (Space)" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next (Ctrl+Right)" Click="OnNext" />
                </StackPanel>

                <Slider x:Name="SeekBar" Grid.Column="1" Margin="18,0,14,0" Style="{StaticResource ThinSlider}"
                        Minimum="0" Maximum="{Binding Length}" Value="{Binding Position}" IsEnabled="{Binding CanSeek}"
                        PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd" />

                <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Click="OnLove">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xEB51;" />
                                <Setter Property="ToolTip" Value="Love (Ctrl+L)" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanLove}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoved}" Value="True">
                                        <Setter Property="Content" Value="&#xEB52;" />
                                        <Setter Property="ToolTip" Value="Loved. Click to un-love (Ctrl+L)" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ToggleButton IsChecked="{Binding Shuffle}" ToolTip="Shuffle">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Content" Value="&#xE8B1;" />
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button Content="{Binding RepeatGlyph}" ToolTip="{Binding RepeatTip}" Click="OnRepeat">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Foreground" Value="{StaticResource TextFaintBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RepeatActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <Slider Width="96" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="100"
                            Value="{Binding Volume}" ToolTip="Volume" />
                </StackPanel>

                <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings"
                        Margin="12,0,0,0" Click="OnSettings" />
            </Grid>
        </Border>

        <!-- ===== Library tabs ===== -->
        <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,4,20,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Music" GroupName="Library"
                                 IsChecked="{Binding Tab, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter=Music}" />
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Mixes" GroupName="Library"
                                 IsChecked="{Binding Tab, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter=Mixes}" />
                    <RadioButton Style="{StaticResource LibraryTab}" Content="Radio" GroupName="Library"
                                 IsChecked="{Binding Tab, Converter={x:Static local:EnumEqualsConverter.Instance}, ConverterParameter=Radio}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Scanning…" Foreground="{StaticResource TextFaintBrush}" FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource TextButton}" Padding="10,4" Margin="12,0,0,4" Click="OnAddStation"
                            Visibility="{Binding ShowRadio, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Add station" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Music ===== -->
        <Grid Grid.Row="2" Visibility="{Binding ShowMusic, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Lined up with the rows: past the album art on the left, the scrollbar on the right. -->
            <Grid Margin="216,10,36,0" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding ArtistWidth, Source={StaticResource MusicColumns}}" />
                    <ColumnDefinition Width="{Binding LengthWidth, Source={StaticResource MusicColumns}}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Style="{StaticResource ColumnHeader}" />
                <TextBlock Grid.Column="1" Text="Title" Style="{StaticResource ColumnHeader}" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Artist" Style="{StaticResource ColumnHeader}" Margin="0,0,16,0" />
                <TextBlock Grid.Column="3" Text="Length" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                <Thumb Grid.Column="2" Style="{StaticResource ColumnDivider}" Tag="MusicColumns|TitleArtist"
                       DragDelta="OnColumnDrag" DragCompleted="OnColumnDragDone" />
                <Thumb Grid.Column="3" Style="{StaticResource ColumnDivider}" Tag="MusicColumns|ArtistLength"
                       DragDelta="OnColumnDrag" DragCompleted="OnColumnDragDone" />
            </Grid>

            <ListView x:Name="MusicList" Grid.Row="1" Style="{StaticResource ListBase}"
                      ItemsSource="{Binding Music.View}"
                      ItemTemplate="{StaticResource TrackRow}"
                      ItemContainerStyle="{StaticResource TrackItem}"
                      SelectionMode="Extended">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Grid Margin="20,20,16,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="168" />
                                                    <ColumnDefinition Width="20" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="168" Height="168" VerticalAlignment="Top" CornerRadius="6"
                                                        Background="{StaticResource ArtPlaceholderBrush}">
                                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="168" Height="168" VerticalAlignment="Top" CornerRadius="6">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Name.Art}" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Name.Title}" FontSize="16" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" Margin="8,2,0,0" />
                                                    <TextBlock Text="{Binding Name.Subtitle}" Foreground="{StaticResource TextDimBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="8,2,0,10" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Music.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Your music library is empty" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Add a folder and Melora will keep it in sync." Foreground="{StaticResource TextDimBrush}"
                           HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource TextButton}" Content="Add music folder…" HorizontalAlignment="Center"
                        Tag="Music" Click="OnAddFolder" />
            </StackPanel>
        </Grid>

        <!-- ===== Mixes ===== -->
        <Grid Grid.Row="2" Visibility="{Binding ShowMixes, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Lined up with the mix titles, which are indented past the DJ picture. -->
            <Grid Margin="76,10,32,0" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding ArtistWidth, Source={StaticResource MixColumns}}" />
                    <ColumnDefinition Width="{Binding LengthWidth, Source={StaticResource MixColumns}}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Title" Style="{StaticResource ColumnHeader}" Margin="0,0,16,0" />
                <TextBlock Grid.Column="1" Text="Artist" Style="{StaticResource ColumnHeader}" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Length" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                <Thumb Grid.Column="1" Style="{StaticResource ColumnDivider}" Tag="MixColumns|TitleArtist"
                       DragDelta="OnColumnDrag" DragCompleted="OnColumnDragDone" />
                <Thumb Grid.Column="2" Style="{StaticResource ColumnDivider}" Tag="MixColumns|ArtistLength"
                       DragDelta="OnColumnDrag" DragCompleted="OnColumnDragDone" />
            </Grid>

            <ListView x:Name="MixesList" Grid.Row="1" Style="{StaticResource ListBase}" Padding="12,0,12,0"
                      ItemsSource="{Binding Mixes.View}"
                      ItemTemplate="{StaticResource MixRow}"
                      ItemContainerStyle="{StaticResource MixItem}"
                      SelectionMode="Extended">
                <!-- One heading per DJ (the mix's folder), A to Z. -->
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel Margin="0,20,0,4">
                                                <StackPanel Orientation="Horizontal" Margin="8,0,0,6">
                                                    <!-- The DJ's picture: their first mix's folder image or embedded art. -->
                                                    <Grid Width="44" Height="44" Margin="0,0,12,0">
                                                        <Border CornerRadius="22" Background="{StaticResource ArtPlaceholderBrush}">
                                                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                       Foreground="{StaticResource TextFaintBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border CornerRadius="22">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{Binding Items[0].Group.Art}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0}'}" FontSize="12"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               Foreground="{StaticResource TextFaintBrush}"
                                                               VerticalAlignment="Center" Margin="10,2,0,0" />
                                                </StackPanel>
                                                <ItemsPresenter />
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListView.GroupStyle>
            </ListView>

            <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Mixes.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="No mixes yet" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Point Melora at the folder where you keep DJ sets and mixes."
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource TextButton}" Content="Add mixes folder…" HorizontalAlignment="Center"
                        Tag="Mixes" Click="OnAddFolder" />
            </StackPanel>
        </Grid>

        <!-- ===== Radio ===== -->
        <Grid Grid.Row="2" Visibility="{Binding ShowRadio, Converter={StaticResource BoolToVisibility}}">
            <ListView x:Name="StationList" Style="{StaticResource ListBase}" Padding="12,12,12,0"
                      ItemsSource="{Binding Stations}"
                      ItemTemplate="{StaticResource StationRow}"
                      ItemContainerStyle="{StaticResource StationItem}"
                      SelectionMode="Single"
                      KeyDown="OnStationListKeyDown" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stations.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="No stations yet" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="Paste a stream address and give it a name before you tune in."
                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,6,0,16" />
                <Button Style="{StaticResource TextButton}" Content="Add station…" HorizontalAlignment="Center"
                        Click="OnAddStation" />
            </StackPanel>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="3" Background="{StaticResource BarBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="20,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource TextFaintBrush}"
                           FontSize="12" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding FormatText}" FontFamily="{StaticResource MonoFont}"
                           FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="16,0,0,0" />
                <TextBlock Text="{Binding NowPlaying}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
