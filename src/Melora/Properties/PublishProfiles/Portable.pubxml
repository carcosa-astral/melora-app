<?xml version="1.0" encoding="utf-8"?>
<!-- Portable build: a single folder with Melora.exe, its own .NET runtime and the native audio libraries.
     dotnet publish src/Melora -p:PublishProfile=Portable -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Keep native DLLs beside the exe instead of extracting them to %TEMP%. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>..\..\dist\Melora\</PublishDir>
  </PropertyGroup>
</Project>
