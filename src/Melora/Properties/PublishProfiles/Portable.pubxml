<?xml version="1.0" encoding="utf-8"?>
<!-- Portable build: a single folder with Melora.exe, its own .NET runtime and the native audio libraries.
     dotnet publish src/Melora -p:PublishProfile=Portable -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Not compressed: a compressed exe unpacks all of .NET into private memory at every start,
         which cost about 85 MB of RAM and 0.3 s of startup, for 110 MB less on disk. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Compiled ahead of time, so less is compiled while starting up. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Keep native DLLs beside the exe instead of extracting them to %TEMP%. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>..\..\dist\Melora\</PublishDir>
  </PropertyGroup>
</Project>
