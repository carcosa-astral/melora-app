<?xml version="1.0" encoding="utf-8"?>
<!-- Portable build: a single folder with Melora.exe, its own .NET runtime and the native audio libraries.
     dotnet publish src/Melora -p:PublishProfile=Portable -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- About a third of the size on disk (85 MB instead of 250 MB). The price: .NET is unpacked into
         private memory at every start, about 85 MB more RAM and 0.3 s slower than uncompressed.
         ReadyToRun doesn't help a compressed exe (it only adds more to unpack), so it's off. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Keep native DLLs beside the exe instead of extracting them to %TEMP%. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <PublishDir>..\..\dist\Melora\</PublishDir>
  </PropertyGroup>
</Project>
